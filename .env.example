# Copy this file to .env and fill it in. .env is ignored by git, so it is never uploaded.

# ---- Supabase: the shared database for GitHub Pages ----
# Supabase dashboard > your project > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TABLE=hub
# After filling these in, run:  node tools/make-config.js   (copies them into config.js)

# ---- Local server (launch.bat) ----
PORT=3982
HUB_PIN=

# ---- Prisma: not used by this project ----
# Only needed if you later add a Prisma server. Supabase > Project Settings > Database.
# DATABASE_URL=
# DIRECT_URL=
